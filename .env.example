# Учетные данные для Telegram API
API_ID=
API_HASH=
PHONE_NUMBER=

# Токен Telegram бота для управления
BOT_TOKEN=

# Настройки MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=telegram_crawler

# Настройки Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Настройки краулера
MAX_CHANNELS=100
MESSAGES_LIMIT=1000
CRAWL_INTERVAL=3600  # интервал сбора данных в секундах

# Настройки webhook
WEBHOOK_URL=  # URL для отправки данных
WEBHOOK_SECRET=  # Секретный ключ для подписи запросов
WEBHOOK_RETRY_COUNT=3  # Количество повторных попыток при ошибке
WEBHOOK_RETRY_DELAY=5  # Задержка между повторными попытками в секундах
WEBHOOK_ENABLED=false  # Включение webhook